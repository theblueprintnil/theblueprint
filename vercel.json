{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "agent-engine": {
      "root": "agent-engine",
      "framework": "fastapi"
    },
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "agent-engine",
          "format": "url",
          "env": "AGENT_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "agent-engine"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
