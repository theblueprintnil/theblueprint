DATABASE_URL=postgresql://postgres:postgres@localhost:5433/blueprint
AGENT_DATABASE_URL=postgresql://app_agent:APP_PASSWORD@localhost:5433/blueprint
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
# REDIS_URL is the local broker/backend only; on Vercel tasks.py switches to
# vercel:// + vercel-runtime-cache:// automatically when VERCEL is set.
# AGENT_DATABASE_URL is the RLS-bound app_agent connection for the gateway
# request path; DATABASE_URL stays privileged for the worker and checkpointer.

OMNIROUTE_BASE_URL=https://omniroute.example.com/v1
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_API_KEY
OMNIROUTE_DEEPSEEK_MODEL=deepseek-chat
OMNIROUTE_ZAI_MODEL=glm-4-plus
LLM_TIMEOUT_SECONDS=60

AGENT_PUBLISH_ENDPOINT=

AGENT_JWT_ISSUER=https://agents.blueprint.local
AGENT_JWT_AUDIENCE=blueprint-agent-gateway
AGENT_JWT_LEEWAY_SECONDS=60
AGENT_JWKS_PATH=
AGENT_PINNED_PEM_DIR=
AGENT_PUBLIC_BASE_URL=http://localhost:8100
