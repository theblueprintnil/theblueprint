generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATHLETE
  BRAND
  AGENCY
  GUARDIAN
  ADMIN
}

enum OpportunityStatus {
  OPEN
  APPLIED
  ACCEPTED
  CLOSED
}

enum DealStatus {
  DRAFT
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceType {
  ATHLETE_STUDIO
  AGENCY_WORKSPACE
  GUARDIAN_PORTAL
}

enum InvitationStatus {
  ACTIVE
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BillingStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum PlanType {
  DEMO
  STARTER
  GROWTH
  PREMIUM
}

enum AiRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiApprovalStatus {
  NOT_REQUIRED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  name                  String
  passwordHash          String
  role                  Role     @default(ATHLETE)
  currentOrganizationId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  athlete              Athlete?
  brand                Brand?
  sessions             Session[]
  opportunities        Opportunity[]
  deals                Deal[]
  memberships          Membership[]
  auditLogs            AuditLog[]      @relation("ActorAuditLogs")
  currentOrganization  Organization?   @relation("CurrentUserOrg", fields: [currentOrganizationId], references: [id], onDelete: SetNull)
  createdOrganizations Organization[]  @relation("CreatedOrganizations")
  invitationsSent      Invitation[]    @relation("InvitationActor")
  usageEvents          UsageEvent[]    @relation("UsageEventActor")
  aiRuns               AiRun[]         @relation("AiRunActor")
  projectsOwned        Project[]       @relation("ProjectOwner")
}

model Organization {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  workspaceType WorkspaceType @default(ATHLETE_STUDIO)
  createdById   String?
  createdBy     User?         @relation("CreatedOrganizations", fields: [createdById], references: [id], onDelete: SetNull)
  demoExpiresAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  memberships    Membership[]
  currentMembers User[]        @relation("CurrentUserOrg")
  opportunities  Opportunity[]
  deals          Deal[]
  auditLogs      AuditLog[]
  invitations    Invitation[]
  projects       Project[]
  usageEvents    UsageEvent[]
  aiRuns         AiRun[]
  subscription   Subscription?
  entitlement    Entitlement?
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, organizationId])
}

model Athlete {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  sport              String
  school             String
  bio                String?
  avatarUrl          String?
  followerCount      Int      @default(0)
  verificationStatus String   @default("VERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Brand {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  industry  String
  logoUrl   String?
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id             String            @id @default(uuid())
  title          String
  brandName      String
  payout         Float
  sport          String
  location       String
  deadline       String
  status         OpportunityStatus @default(OPEN)
  description    String
  ownerUserId    String?
  owner          User?             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Deal {
  id             String        @id @default(uuid())
  title          String
  brandName      String
  athleteName    String
  amount         Float
  status         DealStatus    @default(ACTIVE)
  stage          String
  deliverables   Int           @default(1)
  startDate      String
  endDate        String
  ownerUserId    String?
  owner          User?         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String        @id @default(uuid())
  action         String
  entityType     String
  entityId       String
  actorId        String?
  actor          User?         @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  details        String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           MembershipRole   @default(MEMBER)
  tokenHash      String           @unique
  status         InvitationStatus @default(ACTIVE)
  expiresAt      DateTime
  invitedById    String?
  invitedBy      User?            @relation("InvitationActor", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Subscription {
  id                   String         @id @default(uuid())
  organizationId       String         @unique
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeCustomerId     String         @unique
  stripeSubscriptionId String         @unique
  stripePriceId        String?
  status               BillingStatus  @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean        @default(false)
  trialEnd             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Entitlement {
  id               String         @id @default(uuid())
  organizationId   String         @unique
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             PlanType       @default(DEMO)
  seatsLimit       Int            @default(1)
  aiCreditsMonthly Int            @default(0)
  aiCreditsUsed    Int            @default(0)
  modules          Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WebhookEvent {
  id        String   @id @default(uuid())
  source    String
  eventId   String   @unique
  type      String
  payload   Json
  processedAt DateTime? @default(now())
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

model UsageEvent {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation("UsageEventActor", fields: [userId], references: [id], onDelete: SetNull)
  eventType      String
  quantity       Int            @default(1)
  externalRef    String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([organizationId, createdAt])
}

model AiRun {
  id                  String           @id @default(uuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?            @relation("AiRunActor", fields: [userId], references: [id], onDelete: SetNull)
  status              AiRunStatus      @default(PENDING)
  kind                String?
  featureKey          String?
  model               String
  promptTemplateVersion String?
  inputRef            Json?
  outputRef           Json?
  inputTokens         Int              @default(0)
  outputTokens        Int              @default(0)
  cost                Float            @default(0)
  policySnapshotId    String?
  sourceCitations     Json?
  reviewRequired      Boolean          @default(false)
  reviewerId          String?
  approvalStatus      AiApprovalStatus @default(NOT_REQUIRED)
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, featureKey, createdAt])
  @@index([reviewRequired, approvalStatus])
}

model Project {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  status         ProjectStatus @default(ACTIVE)
  ownerUserId    String?
  owner          User?         @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}
